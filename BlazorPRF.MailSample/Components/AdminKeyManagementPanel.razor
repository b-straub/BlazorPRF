@using BlazorPRF.Api.Models
@using BlazorPRF.Mail.Models
@using TextCopy
@inherits AdminKeyModelComponent
@inject IClipboard Clipboard

<MudItem xs="12" md="6">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Register New Key</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudTextField @bind-Value="Model.NewKeyId"
                          Label="Key ID (optional, defaults to public key)"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudTextField @bind-Value="Model.NewPublicKey"
                          Label="Public Key (Ed25519 base64)"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudTextField @bind-Value="Model.NewUserId"
                          Label="User ID (optional)"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudButtonAsyncRx Command="Model.RegisterKey"
                              Color="Color.Primary"
                              Variant="Variant.Filled"
                              StartIcon="@Icons.Material.Filled.PersonAdd">
                Register Key
            </MudButtonAsyncRx>
        </MudCardContent>
    </MudCard>

    <MudCard Class="mt-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Admin Signing Key</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (!string.IsNullOrEmpty(Model.PrfModel.Ed25519PublicKey))
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body2" Style="font-family: monospace; word-break: break-all;">
                        @Model.PrfModel.Ed25519PublicKey
                    </MudText>
                    <MudTooltip Text="Copy to clipboard">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       Color="Color.Primary"
                                       OnClick="CopySigningKeyAsync" />
                    </MudTooltip>
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                    This key must be in secure/admin_keys.json on the server
                </MudText>
            }
        </MudCardContent>
    </MudCard>
</MudItem>

<MudItem xs="12" md="6">
    <MudCard>
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Registered Keys</MudText>
                    <MudIconButtonAsyncRx Command="Model.LoadKeys"
                                          Icon="@Icons.Material.Filled.Refresh"
                                          Color="Color.Primary" />
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (Model.LoadKeys.Executing)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (Model.RegisteredKeys.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    No keys registered yet.
                </MudText>
            }
            else
            {
                <MudList T="RegisteredKey" Dense="true">
                    @foreach (var key in Model.RegisteredKeys)
                    {
                        <MudListItem>
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-family: monospace;">
                                        @AdminKeyModel.TruncateKey(key.KeyId)
                                    </MudText>
                                    @if (!string.IsNullOrEmpty(key.UserId))
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            User: @key.UserId
                                        </MudText>
                                    }
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @key.CreatedDateTime.ToString("g")
                                    </MudText>
                                </div>
                                <MudIconButtonAsyncRxOf T="string"
                                                    Command="Model.RevokeKey"
                                                    Parameter="key.KeyId"
                                                    Icon="@Icons.Material.Filled.Delete"
                                                    Color="Color.Error"
                                                    Size="Size.Small" />
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    </MudCard>
</MudItem>

@code {
    protected override async Task OnContextReadyAsync()
    {
        await Model.LoadKeys.ExecuteAsync();
    }

    private async Task CopySigningKeyAsync()
    {
        if (string.IsNullOrEmpty(Model.PrfModel.Ed25519PublicKey))
        {
            return;
        }

        try
        {
            await Clipboard.SetTextAsync(Model.PrfModel.Ed25519PublicKey);
            Model.StatusModel.AddSuccess("Signing key copied!");
        }
        catch
        {
            Model.StatusModel.AddError("Failed to copy");
        }
    }
}
