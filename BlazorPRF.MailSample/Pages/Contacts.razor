@page "/contacts"
@attribute [Authorize]
@inherits ContactsModelComponent
@using BlazorPRF.Mail.Models
@using BlazorPRF.Persistence.Data.Models
@inject IDialogService DialogService
@inject InviteAcceptanceModel InviteAcceptanceModel
@inject InviteCreationModel InviteCreationModel
@inject MailApiModel MailApiModel
<PageTitle>Contacts - BlazorPRF</PageTitle>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="8">
        <MudText Typo="Typo.h4" GutterBottom="true">Trusted Contacts</MudText>
        <MudText Typo="Typo.body1">
            Manage your verified contacts. User data is encrypted with your PRF-derived key.
        </MudText>
    </MudItem>
</MudGrid>

<ContactsPanel OnCreateInviteRequested="OpenCreateInviteDialogAsync"
               OnAcceptInviteRequested="OpenAcceptInviteDialogAsync"
               OnVerifyResponseRequested="OpenVerifyDialogAsync"
               OnEncryptRequested="OpenEncryptDialogAsync" />

@code {
    private async Task OpenVerifyDialogAsync()
    {
        if (!await Model.PrfModel.EnsureKeysAsync())
        {
            return;
        }

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<VerifyResponseDialog>("Verify Response & Add Contact", options);
        _ = await dialog.Result;
    }

    private async Task OpenCreateInviteDialogAsync()
    {
        if (!await Model.PrfModel.EnsureKeysAsync())
        {
            return;
        }

        await InviteCreationModel.LoadProfileAsync();
        await EnsureMailProfileAsync();

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<CreateInviteDialog>("Create New Invitation", options);
    }

    private async Task OpenAcceptInviteDialogAsync()
    {
        if (!await Model.PrfModel.EnsureKeysAsync())
        {
            return;
        }

        // Load profile before opening dialog to avoid async re-renders during dialog init
        await InviteAcceptanceModel.LoadProfileAsync();
        await EnsureMailProfileAsync();

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<AcceptInviteDialog>("Accept an Invitation", options);
    }

    private async Task OpenEncryptDialogAsync((TrustedContact Contact, ContactUserData? UserData) args)
    {
        await EnsureMailProfileAsync();

        var parameters = new DialogParameters<EncryptAndSendDialog>
        {
            { x => x.RecipientPublicKey, args.Contact.X25519PublicKey },
            { x => x.RecipientName, args.UserData?.Username ?? "Unknown" },
            { x => x.RecipientEmail, args.UserData?.Email }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<EncryptAndSendDialog>("Encrypt & Send", parameters, options);
    }

    private async Task EnsureMailProfileAsync()
    {
        if (MailApiModel.Profile is null)
        {
            await MailApiModel.LoadProfile.ExecuteAsync();
        }
    }
}
