# Deny access to sensitive directories (mod_rewrite path)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Only allow index.php — block all other PHP files and sensitive directories
    RewriteRule ^secure/ - [F,L]
    RewriteRule ^data/ - [F,L]
    RewriteRule ^lib/ - [F,L]
    RewriteRule ^actions/ - [F,L]
    RewriteRule ^PrfCrypto/ - [F,L]

    # Block direct access to any PHP file except index.php
    RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
    RewriteCond %{REQUEST_URI} !^/index\.php$
    RewriteRule .* - [F,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Block access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block access to .json files
<FilesMatch "\.json$">
    Require all denied
</FilesMatch>
