@inherits UserProfileModelComponent

@if (Model.Loading)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        <MudText>Loading profile...</MudText>
    </MudStack>
}
else if (Model.ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Outlined">
        @Model.ErrorMessage
    </MudAlert>
}
else if (Model.FormData is not null)
{
    <EditForm Model="Model.FormData" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />
        <MudCard>
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Your Profile</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Personal information and mail configuration</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">Profile</MudText>

                <MudTextField @bind-Value="Model.FormData.Username"
                              Label="Display Name"
                              Variant="Variant.Outlined"
                              Placeholder="user"
                              For="@(() => Model.FormData.Username)"
                              Class="mb-4"
                              Disabled="@Model.Saving" />

                <MudTextField @bind-Value="Model.FormData.Email"
                              Label="Email Address"
                              Variant="Variant.Outlined"
                              Placeholder="user@example.com"
                              For="@(() => Model.FormData.Email)"
                              Class="mb-4"
                              Disabled="@Model.Saving" />

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Mail Relay</MudText>

                <MudTextField @bind-Value="Model.FormData.MailRelayUrl"
                              Label="Mail Relay URL"
                              Variant="Variant.Outlined"
                              Placeholder="https://your-relay.example.com/api/"
                              For="@(() => Model.FormData.MailRelayUrl)"
                              Class="mb-4"
                              Disabled="@Model.Saving" />

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">SMTP Settings (Outgoing Mail)</MudText>

                <MudGrid>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="Model.FormData.SmtpHost"
                                      Label="SMTP Host"
                                      Variant="Variant.Outlined"
                                      Placeholder="smtp.example.com"
                                      For="@(() => Model.FormData.SmtpHost)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="Model.FormData.SmtpPort"
                                         Label="Port"
                                         Variant="Variant.Outlined"
                                         For="@(() => Model.FormData.SmtpPort)"
                                         Disabled="@Model.Saving" />
                    </MudItem>
                </MudGrid>

                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.FormData.SmtpUsername"
                                      Label="Username"
                                      Variant="Variant.Outlined"
                                      Placeholder="user@example.com"
                                      For="@(() => Model.FormData.SmtpUsername)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.FormData.SmtpPassword"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      For="@(() => Model.FormData.SmtpPassword)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">IMAP Settings (Incoming Mail)</MudText>

                <MudGrid>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="Model.FormData.ImapHost"
                                      Label="IMAP Host"
                                      Variant="Variant.Outlined"
                                      Placeholder="imap.example.com"
                                      For="@(() => Model.FormData.ImapHost)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="Model.FormData.ImapPort"
                                         Label="Port"
                                         Variant="Variant.Outlined"
                                         For="@(() => Model.FormData.ImapPort)"
                                         Disabled="@Model.Saving" />
                    </MudItem>
                </MudGrid>

                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.FormData.ImapUsername"
                                      Label="Username"
                                      Variant="Variant.Outlined"
                                      Placeholder="user@example.com"
                                      For="@(() => Model.FormData.ImapUsername)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Model.FormData.ImapPassword"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      For="@(() => Model.FormData.ImapPassword)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions>
                <MudSpacer />
                <MudButton ButtonType="ButtonType.Submit"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@Model.Saving">
                    @if (Model.Saving)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Profile</span>
                    }
                </MudButton>
            </MudCardActions>
        </MudCard>
    </EditForm>
}

@code {
    /// <summary>
    /// Default relay URL for new profiles (set by parent page from MailApiModel.RelayUrl).
    /// </summary>
    [Parameter]
    public string? InitialRelayUrl { get; set; }

    protected override async Task OnContextReadyAsync()
    {
        Model.InitialRelayUrl = InitialRelayUrl;
        await Model.LoadProfile.ExecuteAsync();
    }

    private async Task OnValidSubmitAsync()
    {
        if (Model.FormData is null)
        {
            return;
        }

        await Model.SaveProfile.ExecuteAsync(Model.FormData);
    }
}
