@page "/mail-api"
@attribute [Authorize]
@inherits MailApiModelComponent
@using BlazorPRF.Api.Models
@using BlazorPRF.Mail.Components
@using BlazorPRF.Mail.Models
@using BlazorPRF.Sample.Components
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject TextCopy.IClipboard Clipboard
@inject InviteAcceptanceModel InviteAcceptanceModel

<PageTitle>Mail - BlazorPRF</PageTitle>

@if (Model.PrfModel is { HasKeys: false, RequiresOnDemandAuth: false })
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Please derive keys first using the authentication panel.
    </MudAlert>
}
else if (Model.PrfModel.Role == PrfUserRole.UNKNOWN)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8">
        <MudProgressCircular Indeterminate="true" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Checking mail relay access...</MudText>
    </MudStack>
}
else if (Model.PrfModel.Role == PrfUserRole.UNREGISTERED)
{
    <MudText Typo="Typo.h4" GutterBottom="true">Mail Relay Setup</MudText>

    <MudCard Class="mb-4">
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudIcon Icon="@Icons.Material.Filled.Key" Color="Color.Primary" />
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Your Ed25519 Signing Key</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudTextField Value="@Model.PrfModel.Ed25519PublicKey"
                          Label="Ed25519 Public Key (Base64)"
                          Variant="Variant.Filled"
                          ReadOnly="true"
                          Style="font-family: monospace;"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                          OnAdornmentClick="CopySigningKeyAsync" />
        </MudCardContent>
    </MudCard>

    @if (Model.ServerHasAdmin is null)
    {
        @* Server unreachable — show relay URL config *@
        <MudCard Class="mb-4">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.CloudOff" Color="Color.Error" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Mail Relay Unreachable</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Cannot connect to the mail relay server</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Configure the Mail Relay URL in
                    <MudLink Href="settings" Underline="Underline.Always">Settings</MudLink>
                    to point to your PHP mail relay server.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync">
                    Reload
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
    else if (Model.ServerHasAdmin == false)
    {
        @* No admin configured — first-time setup *@
        <MudCard>
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Color="Color.Info" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">First-Time Setup</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No admin is configured on the server yet</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-2">
                    To become admin, install your signing key on the server:
                </MudText>
                <MudList T="string" Dense="true">
                    <MudListItem Icon="@Icons.Material.Filled.LooksOne" IconColor="Color.Primary">
                        Copy your signing key above
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.LooksTwo" IconColor="Color.Primary">
                        SSH into your server and create <code>secure/admin_keys.json</code>:
                        <MudText Typo="Typo.body2" Style="font-family: monospace;" Class="mt-1 pa-2 mud-background-gray rounded">
                            { "admin": "@Model.PrfModel.Ed25519PublicKey" }
                        </MudText>
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.Looks3" IconColor="Color.Primary">
                        Click Reload — you will be recognized as admin
                    </MudListItem>
                </MudList>
            </MudCardContent>
            <MudCardActions>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync">
                    Reload
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
    else
    {
        @* Admin exists but this user is not registered *@
        <MudCard>
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Warning" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Registration Required</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Your key is not registered on the mail relay</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2">
                    Ask your admin to register your signing key on the Mail page (Admin panel → Register New Key).
                    Copy and share the key above.
                </MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Color="Color.Primary"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadAsync">
                    Reload
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
}
else
{
    @* Registered user or admin — show mail UI *@
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudText Typo="Typo.h4" GutterBottom="true">Mail (Admin)</MudText>
        </Authorized>
        <NotAuthorized>
            <MudText Typo="Typo.h4" GutterBottom="true">Mail</MudText>
        </NotAuthorized>
    </AuthorizeView>

    <MudGrid>
        <MudItem xs="12">
            <MailInboxPanel OnAcceptInviteRequested="HandleAcceptInviteAsync"
                            OnVerifyResponseRequested="HandleVerifyResponseAsync" />
        </MudItem>

        <MudItem xs="12">
            <MudExpansionPanels>
                <MudExpansionPanel Text="Debug Tools">
                    <MudStack Spacing="4">
                        <MudButton Color="Color.Info"
                                   Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.NetworkCheck"
                                   OnClick="@(() => Model.TestImap.ExecuteAsync())"
                                   Disabled="@Model.IsTestingImap">
                            @(Model.IsTestingImap ? "Testing IMAP..." : "Test IMAP Connection")
                        </MudButton>
                        @if (Model.MailboxInfo is not null)
                        {
                            <MudStack Row="true">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@Model.MailboxInfo.Messages messages</MudChip>
                                @if (Model.MailboxInfo.Unseen > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@Model.MailboxInfo.Unseen unread</MudChip>
                                }
                            </MudStack>
                        }
                        <MailSendPanel />
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudItem>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <AdminKeyManagementPanel OnKeysChanged="HandleKeysChanged" />
            </Authorized>
        </AuthorizeView>
    </MudGrid>
}

@code {
    protected override async Task OnContextReadyAsync()
    {
        await Model.LoadProfileAndFetchAsync();
        ProcessQueryParams();
    }

    private async Task ReloadAsync()
    {
        Model.PrfModel.Role = PrfUserRole.UNKNOWN;
        await Model.LoadProfileAndFetchAsync();
    }

    private async Task CopySigningKeyAsync()
    {
        if (string.IsNullOrEmpty(Model.PrfModel.Ed25519PublicKey))
        {
            return;
        }

        try
        {
            await Clipboard.SetTextAsync(Model.PrfModel.Ed25519PublicKey);
            Model.StatusModel.AddSuccess("Signing key copied!");
        }
        catch
        {
            Model.StatusModel.AddError("Failed to copy");
        }
    }

    private void ProcessQueryParams()
    {
        var uri = new Uri(NavigationManager.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var to = queryParams["to"];
        var subject = queryParams["subject"];
        var body = queryParams["body"];

        if (!string.IsNullOrWhiteSpace(to) ||
            !string.IsNullOrWhiteSpace(subject) ||
            !string.IsNullOrWhiteSpace(body))
        {
            Model.PreFillSend(to, subject, body);
        }
    }

    private void HandleKeysChanged(List<RegisteredKey> keys)
    {
        StateHasChanged();
    }

    private async Task HandleAcceptInviteAsync(string armoredInvite)
    {
        await InviteAcceptanceModel.LoadProfileAsync();
        if (Model.Profile is null)
        {
            await Model.LoadProfile.ExecuteAsync();
        }

        var parameters = new DialogParameters<AcceptInviteDialog>
        {
            { x => x.InitialInvite, armoredInvite }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<AcceptInviteDialog>("Accept Invitation", parameters, options);
    }

    private async Task HandleVerifyResponseAsync(string armoredResponse)
    {
        var parameters = new DialogParameters<VerifyResponseDialog>
        {
            { x => x.InitialResponse, armoredResponse }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<VerifyResponseDialog>("Verify Response", parameters, options);
    }
}
