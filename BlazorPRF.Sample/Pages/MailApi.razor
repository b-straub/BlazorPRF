@page "/mail-api"
@attribute [Authorize]
@inherits MailApiModelComponent
@using BlazorPRF.Api.Models
@using BlazorPRF.Mail.Components
@using BlazorPRF.Mail.Models
@using BlazorPRF.Sample.Components
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject InviteAcceptanceModel InviteAcceptanceModel

<PageTitle>Mail - BlazorPRF</PageTitle>

@if (Model.PrfModel is { HasKeys: false, RequiresOnDemandAuth: false })
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Please derive keys first using the authentication panel.
    </MudAlert>
}
else if (Model.PrfModel.Role == PrfUserRole.UNKNOWN)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-8">
        <MudProgressCircular Indeterminate="true" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Checking mail relay access...</MudText>
    </MudStack>
}
else if (Model.PrfModel.Role == PrfUserRole.UNREGISTERED)
{
    <MudText Typo="Typo.h4" GutterBottom="true">Mail</MudText>
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Mail relay is not configured. Complete setup in
        <MudLink Href="settings" Underline="Underline.Always">Settings</MudLink>.
    </MudAlert>
}
else
{
    @* Registered user or admin — show mail UI *@
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudText Typo="Typo.h4" GutterBottom="true">Mail (Admin)</MudText>
        </Authorized>
        <NotAuthorized>
            <MudText Typo="Typo.h4" GutterBottom="true">Mail</MudText>
        </NotAuthorized>
    </AuthorizeView>

    <MudGrid>
        <MudItem xs="12">
            <MailInboxPanel OnAcceptInviteRequested="HandleAcceptInviteAsync"
                            OnVerifyResponseRequested="HandleVerifyResponseAsync" />
        </MudItem>

        <MudItem xs="12">
            <MudExpansionPanels>
                <MudExpansionPanel Text="Debug Tools">
                    <MudStack Spacing="4">
                        <MudButton Color="Color.Info"
                                   Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.NetworkCheck"
                                   OnClick="@(() => Model.TestImap.ExecuteAsync())"
                                   Disabled="@Model.IsTestingImap">
                            @(Model.IsTestingImap ? "Testing IMAP..." : "Test IMAP Connection")
                        </MudButton>
                        @if (Model.MailboxInfo is not null)
                        {
                            <MudStack Row="true">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@Model.MailboxInfo.Messages messages</MudChip>
                                @if (Model.MailboxInfo.Unseen > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">@Model.MailboxInfo.Unseen unread</MudChip>
                                }
                            </MudStack>
                        }
                        <MailSendPanel />
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudItem>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <MudItem xs="12">
                    <MudExpansionPanels>
                        <MudExpansionPanel Text="Administration">
                            <AdminKeyManagementPanel OnKeysChanged="HandleKeysChanged" />
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>
            </Authorized>
        </AuthorizeView>
    </MudGrid>
}

@code {
    protected override async Task OnContextReadyAsync()
    {
        await Model.LoadProfileAndFetchAsync();
        ProcessQueryParams();
    }

    private void ProcessQueryParams()
    {
        var uri = new Uri(NavigationManager.Uri);
        var queryParams = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var to = queryParams["to"];
        var subject = queryParams["subject"];
        var body = queryParams["body"];

        if (!string.IsNullOrWhiteSpace(to) ||
            !string.IsNullOrWhiteSpace(subject) ||
            !string.IsNullOrWhiteSpace(body))
        {
            Model.PreFillSend(to, subject, body);
        }
    }

    private void HandleKeysChanged(List<RegisteredKey> keys)
    {
        StateHasChanged();
    }

    private async Task HandleAcceptInviteAsync(string armoredInvite)
    {
        await InviteAcceptanceModel.LoadProfileAsync();
        if (Model.Profile is null)
        {
            await Model.LoadProfile.ExecuteAsync();
        }

        var parameters = new DialogParameters<AcceptInviteDialog>
        {
            { x => x.InitialInvite, armoredInvite }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<AcceptInviteDialog>("Accept Invitation", parameters, options);
    }

    private async Task HandleVerifyResponseAsync(string armoredResponse)
    {
        var parameters = new DialogParameters<VerifyResponseDialog>
        {
            { x => x.InitialResponse, armoredResponse }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<VerifyResponseDialog>("Verify Response", parameters, options);
    }
}
