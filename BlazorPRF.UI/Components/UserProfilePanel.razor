@using BlazorPRF.Persistence.Data.Models
@inherits UserProfileModelComponent

@if (Model.Loading)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        <MudText>Loading profile...</MudText>
    </MudStack>
}
else if (Model.ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Outlined">
        @Model.ErrorMessage
    </MudAlert>
}
else
{
    <EditForm Model="_profileData" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />
        <MudCard>
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Your Profile</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Personal information and mail configuration</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">Profile</MudText>

                <MudTextField @bind-Value="_profileData.Username"
                              Label="Display Name"
                              Variant="Variant.Outlined"
                              Placeholder="user"
                              For="@(() => _profileData.Username)"
                              Class="mb-4"
                              Disabled="@Model.Saving" />

                <MudTextField @bind-Value="_profileData.Email"
                              Label="Email Address"
                              Variant="Variant.Outlined"
                              Placeholder="user@example.com"
                              For="@(() => _profileData.Email)"
                              Class="mb-4"
                              Disabled="@Model.Saving" />

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">Mail Relay</MudText>

                <MudTextField @bind-Value="_profileData.MailRelayUrl"
                              Label="Mail Relay URL"
                              Variant="Variant.Outlined"
                              Placeholder="https://your-relay.example.com/api/"
                              For="@(() => _profileData.MailRelayUrl)"
                              Class="mb-4"
                              Disabled="@Model.Saving" />

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">SMTP Settings (Outgoing Mail)</MudText>

                <MudGrid>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_profileData.SmtpHost"
                                      Label="SMTP Host"
                                      Variant="Variant.Outlined"
                                      Placeholder="smtp.example.com"
                                      For="@(() => _profileData.SmtpHost)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="_profileData.SmtpPort"
                                         Label="Port"
                                         Variant="Variant.Outlined"
                                         For="@(() => _profileData.SmtpPort)"
                                         Disabled="@Model.Saving" />
                    </MudItem>
                </MudGrid>

                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_profileData.SmtpUsername"
                                      Label="Username"
                                      Variant="Variant.Outlined"
                                      Placeholder="user@example.com"
                                      For="@(() => _profileData.SmtpUsername)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_profileData.SmtpPassword"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      For="@(() => _profileData.SmtpPassword)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">IMAP Settings (Incoming Mail)</MudText>

                <MudGrid>
                    <MudItem xs="12" sm="8">
                        <MudTextField @bind-Value="_profileData.ImapHost"
                                      Label="IMAP Host"
                                      Variant="Variant.Outlined"
                                      Placeholder="imap.example.com"
                                      For="@(() => _profileData.ImapHost)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField @bind-Value="_profileData.ImapPort"
                                         Label="Port"
                                         Variant="Variant.Outlined"
                                         For="@(() => _profileData.ImapPort)"
                                         Disabled="@Model.Saving" />
                    </MudItem>
                </MudGrid>

                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_profileData.ImapUsername"
                                      Label="Username"
                                      Variant="Variant.Outlined"
                                      Placeholder="user@example.com"
                                      For="@(() => _profileData.ImapUsername)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_profileData.ImapPassword"
                                      Label="Password"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Password"
                                      For="@(() => _profileData.ImapPassword)"
                                      Disabled="@Model.Saving" />
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions>
                <MudSpacer />
                <MudButton ButtonType="ButtonType.Submit"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@Model.Saving">
                    @if (Model.Saving)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Profile</span>
                    }
                </MudButton>
            </MudCardActions>
        </MudCard>
    </EditForm>
}

@code {
    /// <summary>
    /// Default relay URL for new profiles (set by parent page from MailApiModel.RelayUrl).
    /// </summary>
    [Parameter]
    public string? InitialRelayUrl { get; set; }

    private UserProfileData _profileData = new();

    protected override async Task OnContextReadyAsync()
    {
        _profileData.MailRelayUrl = InitialRelayUrl;
        await Model.LoadProfile.ExecuteAsync();
    }

    protected override void OnProfileLoadedChanged()
    {
        if (Model.ProfileLoaded && Model.Profile is not null)
        {
            _profileData = new UserProfileData
            {
                Username = Model.Profile.Username,
                Email = Model.Profile.Email,
                MailRelayUrl = Model.Profile.MailRelayUrl ?? InitialRelayUrl,
                SmtpHost = Model.Profile.SmtpHost,
                SmtpPort = Model.Profile.SmtpPort ?? 587,
                SmtpUsername = Model.Profile.SmtpUsername,
                SmtpPassword = Model.Profile.SmtpPassword,
                ImapHost = Model.Profile.ImapHost,
                ImapPort = Model.Profile.ImapPort ?? 993,
                ImapUsername = Model.Profile.ImapUsername,
                ImapPassword = Model.Profile.ImapPassword
            };
            StateHasChanged();
        }
    }

    protected override void OnSuccessMessageChanged()
    {
        if (Model.SuccessMessage is not null)
        {
            Model.StatusModel.AddInfo(Model.SuccessMessage);
        }
    }

    private async Task OnValidSubmitAsync()
    {
        await Model.SaveProfile.ExecuteAsync(_profileData);
        // MailApiModel auto-syncs via internal observer — no callback needed
    }
}
